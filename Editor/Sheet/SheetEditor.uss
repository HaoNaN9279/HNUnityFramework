rootVisualElement
{
    width: 100%;
    height: 100%;
}

#sheetRoot 
{
    flex-grow: 1;
    margin-top: 4px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    background-color: rgb(40, 40, 40);
}

#scrollView
{
    flex-grow: 1;
}

#scrollViewContentContainer
{
    flex-direction: row;
}

#leftColumn
{
    position: absolute;
}

#topLeftCorner
{
    position: absolute;
    width: 30px;
    height: 42px;
    background-color: rgb(40, 40, 40);
}

#leftDataColumn
{
    flex-grow: 1;
}

#sheetColumn
{
    width: 100px;
}

#columnSeperator
{
    width: 8px;
    background-color: rgb(66, 66, 66);
    cursor: resize-horizontal;
}

#idField
{
    width: 30px;
    height: 20px;
    top: 2px;
    border-right-width: 2px;
    -unity-text-align: middle-right;
    flex-shrink: 0;
}

.id-row-even
{
    background-color: rgb(65, 65, 65);
}

.id-row-odd
{
    background-color: rgb(90, 90, 90);
}

#columnTitle
{
    flex-grow: 1;
    position: absolute;
    width: 100px;
    background-color: rgb(40, 40, 40);
}

#dataRoot
{
    flex-grow: 1;
}

.data-row-even
{
    background-color: rgb(25, 25, 25);
}

.data-row-odd
{
    background-color: rgb(50, 50, 50);
}

#typeField
{
    flex-grow: 1;
    height: 20px;
    margin-left: 0px;
    margin-top: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
    background-color: rgb(75, 75, 75);
}

#headerField
{
    flex-grow: 1;
    height: 20px;
    margin-left: 0px;
    margin-top: 0px;
    margin-right: 0px;
    margin-bottom: 0px;
    background-color: rgb(75, 75, 75);
}

.unity-base-text-field__input
{
    background-color: rgba(0, 0, 0, 0.0);
    border-color: rgba(0, 0, 0, 0.0);
}

